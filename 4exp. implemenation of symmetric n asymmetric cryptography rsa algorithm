RSA Algorithm (Symmetric & Asymmetric Cryptography) 
 
#include <stdio.h> 
#include <math.h> 
#include <string.h> 
 
long int p, q, n, t, flag, e[50], d[50], temp[50]; 
long int j, m[50], en[50], i; 
 
long int cd(long int); 
void encrypt(); 
void decrypt(); 
 
int prime(long int pr) 
{ 
    int i; 
    for(i = 2; i <= pr/2; i++) 
    { 
        if(pr % i == 0) 
            return 0; 
    } 
    return 1; 
} 
 
int main() 
{ 
    printf("ENTER FIRST PRIME NUMBER\n"); 
    scanf("%ld", &p); 
 
    if(prime(p) == 0) 
    { 
        printf("WRONG INPUT\n"); 
        return 0; 
    } 
 
    printf("\nENTER ANOTHER PRIME NUMBER\n"); 
    scanf("%ld", &q); 
 
    if(prime(q) == 0 || p == q) 
    { 
        printf("WRONG INPUT\n"); 
        return 0; 
    } 
 
    printf("\nENTER MESSAGE\n"); 
    scanf("%s", m); 
 
    n = p * q; 
    t = (p - 1) * (q - 1); 
 
    j = 0; 
 
    for(i = 2; i < t; i++) 
    { 
        if(t % i == 0) 
            continue; 
 
        if(prime(i) && i != p && i != q) 
        { 
            e[j] = i; 
            flag = cd(e[j]); 
 
            if(flag > 0) 
            { 
                d[j] = flag; 
                j++; 
            } 
        } 
    } 
 
    printf("\nPOSSIBLE VALUES OF e AND d ARE\n"); 
    for(i = 0; i < j; i++) 
    { 
        printf("%ld\t%ld\n", e[i], d[i]); 
    } 
 
    encrypt(); 
    decrypt(); 
 
    return 0; 
} 
 
long int cd(long int x) 
{ 
    long int k = 1; 
 
    while(1) 
    { 
        k = k + t; 
 
        if(k % x == 0) 
            return (k / x); 
    } 
} 
 
void encrypt() 
{ 
    long int pt, ct, key = e[0]; 
    i = 0; 
 
    while(m[i] != '\0') 
    { 
        pt = m[i] - 96; 
        long int k = 1; 
 
        for(j = 0; j < key; j++) 
        { 
            k = k * pt; 
            k = k % n; 
        } 
 
        temp[i] = k; 
        ct = k + 96; 
        en[i] = ct; 
        i++; 
    } 
 
    en[i] = -1; 
 
    printf("\nTHE ENCRYPTED MESSAGE IS\n"); 
    for(i = 0; en[i] != -1; i++) 
        printf("%c", en[i]); 
} 
 
void decrypt() 
{ 
    long int pt, ct, key = d[0]; 
    i = 0; 
 
    while(en[i] != -1) 
    { 
        ct = temp[i]; 
        long int k = 1; 
 
        for(j = 0; j < key; j++) 
        { 
            k = k * ct; 
            k = k % n; 
        } 
 
        pt = k + 96; 
        m[i] = pt; 
        i++; 
    } 
 
    m[i] = '\0'; 
 
    printf("\n\nTHE DECRYPTED MESSAGE IS\n%s\n", m); 
} 
 
